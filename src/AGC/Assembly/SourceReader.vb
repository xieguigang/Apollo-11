' ============================================================================
'  SourceReader.vb -- reads AGC (.agc) source, following "$include" directives
'  and splitting each source line into assembler fields.
'
'  Field layout, following the original AGC assembler and yaYUL:
'
'      column 1        : label (optional; a line whose first field starts in
'                        column 1 has a label)
'      columns 9..15   : operation (mnemonic or pseudo-op)
'      columns 16..    : operand, modifier 1, modifier 2, extra
'      "#"             : comment to end of line
'      "$FILE.agc"     : include another source file (start of line)
'
'  A label may also carry a "+n"/"-n" relative offset, as in "TAG +3".
' ============================================================================

Imports System
Imports System.Collections.Generic
Imports System.IO
Imports System.Text

Namespace Agc

    ''' <summary>One parsed source line.</summary>
    Public Class AgcLine
        Public Property File As String
        Public Property LineNumber As Integer
        Public Property Label As String = ""
        Public Property Opcode As String = ""
        Public Property Operand As String = ""
        Public Property Mod1 As String = ""
        Public Property Mod2 As String = ""
        Public Property Extra As String = ""
        Public Property Comment As String = ""
        Public Property RawText As String = ""
        ''' <summary>True for lines generated by an interpreted-operand continuation.</summary>
        Public Property IsContinuation As Boolean
    End Class

    ''' <summary>Reads AGC assembly sources, expanding "$FILE" include directives.</summary>
    Public Class AgcSourceReader

        ''' <summary>Diagnostic: column of the first field of the last parsed line.</summary>
        Public Shared DiagnosticFirstStart As Integer
        ''' <summary>Diagnostic: number of fields in the last parsed line.</summary>
        Public Shared DiagnosticFieldCount As Integer

        Public ReadOnly Diagnostics As AgcDiagnostics
        Private ReadOnly _rootDirectory As String
        Private ReadOnly _searchPaths As New List(Of String)()
        Private Const MaxIncludeDepth As Integer = 16

        Public Sub New(rootDirectory As String, diagnostics As AgcDiagnostics)
            _rootDirectory = rootDirectory
            Diagnostics = diagnostics
            _searchPaths.Add(rootDirectory)
        End Sub

        Public Sub AddSearchPath(path As String)
            If Not String.IsNullOrEmpty(path) AndAlso Not _searchPaths.Contains(path) Then
                _searchPaths.Add(path)
            End If
        End Sub

        ''' <summary>
        ''' Expand <paramref name="startFile"/> (usually MAIN.agc) into the full
        ''' ordered list of source lines.
        ''' </summary>
        Public Function Read(startFile As String) As List(Of AgcLine)
            Dim lines As New List(Of AgcLine)()
            Dim visited As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            ReadInto(startFile, lines, 0, visited)
            Return lines
        End Function

        Private Sub ReadInto(fileName As String, lines As List(Of AgcLine), depth As Integer,
                             visited As HashSet(Of String))
            If depth > MaxIncludeDepth Then
                Diagnostics.Fatal(fileName, 0, "Include nesting too deep.")
                Return
            End If

            Dim resolved As String = ResolveFile(fileName)
            If resolved Is Nothing Then
                Diagnostics.Fatal(fileName, 0, "Source file not found.")
                Return
            End If

            Dim text As String
            Try
                text = File.ReadAllText(resolved)
            Catch ex As Exception
                Diagnostics.Fatal(resolved, 0, "Cannot read source file: " & ex.Message)
                Return
            End Try

            Dim rawLines As String() = text.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf).Split(CChar(vbLf))
            Dim lineNumber As Integer = 0
            For Each raw As String In rawLines
                lineNumber += 1
                Dim trimmed As String = raw.TrimStart()
                If trimmed.StartsWith("$") Then
                    Dim inc As String = trimmed.Substring(1).Trim()
                    ' Strip trailing comments.
                    Dim hash As Integer = inc.IndexOf("#"c)
                    If hash >= 0 Then inc = inc.Substring(0, hash).Trim()
                    If inc.Length > 0 Then
                        ReadInto(inc, lines, depth + 1, visited)
                    End If
                    Continue For
                End If

                Dim line As AgcLine = ParseLine(raw, resolved, lineNumber)
                If line IsNot Nothing Then lines.Add(line)
            Next
        End Sub

        Private Function ResolveFile(name As String) As String
            name = name.Trim()
            If name.Length = 0 Then Return Nothing
            If Path.IsPathRooted(name) Then
                If File.Exists(name) Then Return name
                Return Nothing
            End If
            For Each dir As String In _searchPaths
                If String.IsNullOrEmpty(dir) Then Continue For
                Dim candidate As String = Path.Combine(dir, name)
                If File.Exists(candidate) Then Return candidate
            Next
            ' Also try relative to the process directory.
            If File.Exists(name) Then Return Path.GetFullPath(name)
            Return Nothing
        End Function

        ''' <summary>Split a raw source line into assembler fields.</summary>
        Public Shared Function ParseLine(raw As String, file As String, lineNumber As Integer) As AgcLine
            Dim line As New AgcLine()
            line.File = file
            line.LineNumber = lineNumber
            line.RawText = raw

            Dim work As String = raw
            Dim hash As Integer = work.IndexOf("#"c)
            If hash >= 0 Then
                line.Comment = work.Substring(hash + 1).Trim()
                work = work.Substring(0, hash)
            End If
            If work.Trim().Length = 0 Then Return Nothing

            ' Split into at most six whitespace separated fields.
            Dim fields As New List(Of String)()
            Dim i As Integer = 0
            While i < work.Length AndAlso fields.Count < 6
                While i < work.Length AndAlso Char.IsWhiteSpace(work(i))
                    i += 1
                End While
                If i >= work.Length Then Exit While
                Dim start As Integer = i
                While i < work.Length AndAlso Not Char.IsWhiteSpace(work(i))
                    i += 1
                End While
                fields.Add(work.Substring(start, i - start))
            End While
            If fields.Count = 0 Then Return Nothing

            ' Fields carry fixed meanings, exactly as in the original AGC assembler
            ' and in yaYUL:
            '   column 1        label
            '   columns 9..16   operation
            '   columns 17..    operand, modifier 1, modifier 2, extra
            ' The transcribed sources indent the operation with tabs, which do not
            ' generally line it up on column 9, so the only distinction that can be
            ' relied upon is whether the first field starts in column 1.
            Dim firstStart As Integer = 0
            While firstStart < work.Length AndAlso Char.IsWhiteSpace(work(firstStart))
                firstStart += 1
            End While

            Dim idx As Integer = 0
            If firstStart = 0 Then
                line.Label = fields(0)
                idx = 1
            End If

            ' The transcribed sources occasionally indent a label past column 1,
            ' which hides it from the column rule above.  Find the field that
            ' really is the operation; anything before it is the label.  A field
            ' that is itself a known operation is never demoted to a label, so
            ' "SETLOC 04000" written at column 1 stays a pseudo-op.
            Dim opIndex As Integer = -1
            If idx < fields.Count AndAlso Not IsKnownOperator(fields(idx)) Then
                opIndex = FirstKnownOperatorIndex(fields, idx + 1)
            End If
            If opIndex < 0 Then
                ' No recognised operation on this line; keep the naive layout so
                ' that the assembler can report the unknown operator.
                opIndex = idx
            ElseIf opIndex > idx Then
                For k As Integer = idx To opIndex - 1
                    If line.Label = "" Then
                        line.Label = fields(k)
                    End If
                Next
                idx = opIndex
            End If

            ' Distribute the remaining fields.  These are written as separate
            ' statements rather than colon-separated ones so that the assignment
            ' target and the index update cannot be mis-associated.
            If idx < fields.Count Then
                line.Opcode = fields(idx)
                idx = idx + 1
            End If
            If idx < fields.Count Then
                line.Operand = fields(idx)
                idx = idx + 1
            End If
            If idx < fields.Count Then
                line.Mod1 = fields(idx)
                idx = idx + 1
            End If
            If idx < fields.Count Then
                line.Mod2 = fields(idx)
                idx = idx + 1
            End If
            If idx < fields.Count Then
                line.Extra = fields(idx)
                idx = idx + 1
            End If
            Return line
        End Function

        ''' <summary>True when the text names an operation, pseudo-op or alias.</summary>
        Public Shared Function IsKnownOperator(text As String) As Boolean
            If String.IsNullOrEmpty(text) Then Return False
            Dim interp As AgcOpcode = Nothing
            If AgcOpcodeTable.TryGetInterpretive(text, interp) Then Return True
            Dim o As AgcOpcode = Nothing
            If AgcOpcodeTable.TryGetBasic(text, o) Then Return True
            Return IsPseudoOpName(text)
        End Function

        ''' <summary>
        ''' True for the pseudo-ops the assembler handles natively (directives and
        ''' data producers) as opposed to instructions.
        ''' </summary>
        Public Shared Function IsPseudoOpName(text As String) As Boolean
            Select Case text
                Case "SETLOC", "LOC", "BANK", "BLOCK", "EBANK=", "SBANK=", "EQUALS", "=", "=MINUS",
                     "=ECADR", "CHECK=", "ERASE", "COUNT", "COUNT*", "BNKSUM", "BANKSUM", "MEMORY",
                     "SUBRO", "SECSIZ", "OCT", "OCTAL", "DEC", "DEC*", "2DEC", "2DEC*", "2OCT", "MM",
                     "VN", "NV", "ADRES", "CADR", "FCADR", "2FCADR", "ECADR", "GENADR", "REMADR",
                     "DNPTR", "-DNPTR", "BBCON", "BBCON*", "2CADR", "2BCADR", "XCADR",
                     "1DNADR", "2DNADR", "3DNADR", "4DNADR", "5DNADR", "6DNADR",
                     "-1DNADR", "-2DNADR", "-3DNADR", "-4DNADR", "-5DNADR", "-6DNADR",
                     "-GENADR", "-2CADR", "-DNCHAN", "DNCHAN", "-CCS"
                    Return True
                Case Else
                    Return False
            End Select
        End Function

        ''' <summary>
        ''' Re-lay a line whose first field turned out not to be an operation.
        ''' The transcribed sources sometimes indent a label past column 1, in
        ''' which case the label was mistaken for the operation.  When the first
        ''' field is not a known operation but a later field is, the fields are
        ''' shifted right so that the first becomes the label.

        ''' <summary>Find the first field that names a known operation, or -1.</summary>
        Private Shared Function FirstKnownOperatorIndex(fields As List(Of String), start As Integer) As Integer
            For i As Integer = start To fields.Count - 1
                If IsKnownOperator(fields(i)) Then Return i
            Next
            Return -1
        End Function

        ''' <summary>True for the "+3"/"-2" style relative labels.</summary>
        Public Shared Function IsRelativeLabel(text As String) As Boolean
            If String.IsNullOrEmpty(text) Then Return False
            If text(0) <> "+"c AndAlso text(0) <> "-"c Then Return False
            If text.Length < 2 Then Return False
            For i As Integer = 1 To text.Length - 1
                If Not Char.IsDigit(text(i)) Then Return False
            Next
            Return True
        End Function

        ''' <summary>
        ''' Combine the operand and modifier fields the way FetchSymbolPlusOffset
        ''' does: "TAG" + "+3" becomes "TAG+3" and "TAG" + "3" also becomes "TAG+3".
        ''' </summary>
        Public Shared Function CombineOperandAndOffset(operand As String, mod1 As String, mod2 As String) As String
            If String.IsNullOrEmpty(mod1) AndAlso String.IsNullOrEmpty(mod2) Then Return operand
            Dim sb As New StringBuilder(operand)
            If Not String.IsNullOrEmpty(mod1) Then sb.Append(mod1)
            If Not String.IsNullOrEmpty(mod2) Then sb.Append(mod2)
            Return sb.ToString()
        End Function

    End Class

End Namespace
