' ============================================================================
'  Core/LineParserProbe.vb -- temporary development probe.
' ============================================================================

Imports System

Namespace Agc

    Module LineParserProbe

        Friend Sub Dump()
            Dim t As String = Chr(9)
            Dim samples As String() = New String() { _
                t & "SETLOC" & t & "04000", _
                t & "BANK", _
                "START" & t & "TC" & t & "START", _
                t & "CA" & t & "Q", _
                t & "OCT" & t & "12345", _
                t & "DEC" & t & "42", _
                "	SETLOC	04000"}
            For Each s As String In samples
                Dim l As AgcLine = AgcSourceReader.ParseLine(s, "probe", 1)
                Dim desc As String
                If l Is Nothing Then
                    desc = "<null>"
                Else
                    desc = "label=[" & l.Label & "] op=[" & l.Opcode & "] operand=[" & l.Operand & "]"
                End If
                Console.WriteLine("PARSED [" & s.Replace(t, "<T>") & "] -> " & desc)
            Next
        End Sub

    End Module

End Namespace
