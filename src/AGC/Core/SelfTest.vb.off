' ============================================================================
'  SelfTest.vb -- assembler and hardware self tests.
'
'  These check the pieces that are easiest to get subtly wrong: 15-bit
'  one's-complement arithmetic, pseudo-address conversion, the program-counter
'  increment rules, the numeric literal encoders, the opcode tables, the
'  interpretive instruction encoding, and a small end-to-end assembly.
' ============================================================================

Imports System
Imports System.Collections.Generic
Imports System.IO
Imports System.Text

Namespace Agc

    Public Module AgcSelfTest

        Private _failures As Integer
        Private _checks As Integer

        Public Function RunAll() As Integer
            _failures = 0
            _checks = 0

            TestWordArithmetic()
            TestAddressConversion()
            TestIncrement()
            TestDecEncoders()
            TestLiteralParsing()
            TestOpcodeTables()
            TestInterpreterEncoding()
            TestTinyAssembly()

            Return _failures
        End Function

        Private Sub Check(condition As Boolean, name As String, Optional detail As String = "")
            _checks += 1
            If Not condition Then
                _failures += 1
                Console.WriteLine("FAIL: " & name & If(String.IsNullOrEmpty(detail), "", "  (" & detail & ")"))
            End If
        End Sub

        Private Sub CheckEqual(actual As Integer, expected As Integer, name As String)
            Check(actual = expected, name,
                  "expected " & AgcWord.ToOctal(expected) & ", got " & AgcWord.ToOctal(actual))
        End Sub

        ' ==================================================================

        Private Sub TestWordArithmetic()
            ' AGC one's-complement reference values:
            '   +0 = 00000   -0 = 77777   -1 = 77776   -2 = 77775
            CheckEqual(AgcWord.ToSigned(&H7FFF), 0, "minus zero is signed zero")
            CheckEqual(AgcWord.ToSigned(&H7FFE), -1, "077776 is minus one")
            CheckEqual(AgcWord.ToSigned(&H7FFD), -2, "077775 is minus two")
            CheckEqual(AgcWord.FromSigned(-1), &H7FFE, "encode minus one")
            CheckEqual(AgcWord.FromSigned(-2), &H7FFD, "encode minus two")

            CheckEqual(AgcWord.Complement(0), &H7FFF, "complement of plus zero is minus zero")
            CheckEqual(AgcWord.Complement(1), &H7FFE, "complement of one is 077776")

            ' Negation follows "complement plus one with end-around carry".
            CheckEqual(AgcWord.Negate(0), 0, "negate plus zero is plus zero")
            CheckEqual(AgcWord.Negate(1), &H7FFF, "negate one is 077777")
            CheckEqual(AgcWord.Negate(2), &H7FFE, "negate two is 077776")
            CheckEqual(AgcWord.Negate(&H7FFE), 2, "negate 077776 is two")

            ' Absolute value treats the all-ones word as zero.
            CheckEqual(AgcWord.AbsWord(&H7FFF), 0, "absolute value of 077777")
            CheckEqual(AgcWord.AbsWord(&H7FFE), 2, "absolute value of 077776")
            CheckEqual(AgcWord.AbsWord(&H7FFD), 3, "absolute value of 077775")

            CheckEqual(AgcWord.Add(1, 1), 2, "one plus one")
            CheckEqual(AgcWord.Add(&H7FFF, 1), 0, "077777 plus one wraps to zero")
            CheckEqual(AgcWord.Add(&H7FFE, 1), 0, "077776 plus one")
            CheckEqual(AgcWord.Add(&H7FFD, &H7FFD), &H7FFA, "077775 plus itself")
        End Sub

        Private Sub TestAddressConversion()
            Dim a As AgcAddress

            a = AgcCodec.PseudoToAddress(&H0)
            Check(a.IsErasable AndAlso a.Unbanked AndAlso a.SReg = 0,
                  "pseudo 00000 is unswitched erasable 0", a.ToString())

            a = AgcCodec.PseudoToAddress(&H2FF)
            Check(a.IsErasable AndAlso a.Unbanked AndAlso a.SReg = &H2FF,
                  "pseudo 01377 is the last unswitched erasable word", a.ToString())

            a = AgcCodec.PseudoToAddress(&H300)
            Check(a.IsErasable AndAlso a.Banked AndAlso a.EB = 2 AndAlso a.SReg = 5120,
                  "pseudo 01400 is switched erasable bank 2", a.ToString())

            a = AgcCodec.PseudoToAddress(&H400)
            Check(a.IsErasable AndAlso a.Banked AndAlso a.EB = 3 AndAlso a.SReg = 5120,
                  "pseudo 02000 is switched erasable bank 3", a.ToString())

            a = AgcCodec.PseudoToAddress(&H7FF)
            Check(a.IsErasable AndAlso a.Banked AndAlso a.EB = 7 AndAlso a.SReg = 6144,
                  "pseudo 03777 is switched erasable bank 7", a.ToString())

            a = AgcCodec.PseudoToAddress(&H800)
            Check(a.IsFixed AndAlso a.Unbanked AndAlso a.SReg = &H800,
                  "pseudo 04000 is unswitched fixed bank 2", a.ToString())

            a = AgcCodec.PseudoToAddress(&H1000)
            Check(a.IsFixed AndAlso a.Banked AndAlso a.FB = 2 AndAlso a.SReg = 2048,
                  "pseudo 010000 is fixed bank 2", a.ToString())

            a = AgcCodec.PseudoToAddress(&H1400)
            Check(a.IsFixed AndAlso a.Banked AndAlso a.FB = 4 AndAlso a.SReg = 2048,
                  "pseudo 014000 is fixed bank 4", a.ToString())

            a = AgcCodec.PseudoToAddress(&H3000)
            Check(a.IsFixed AndAlso a.Banked AndAlso a.Super AndAlso a.FB = 36,
                  "pseudo 030000 is super bank 034", a.ToString())

            Dim probes As Integer() = {0, 767, 1023, 1024, 1791, 2048, 4095, 4096, 6144, 8192, 12288, 17408}
            For Each p As Integer In probes
                Dim q As AgcAddress = AgcCodec.PseudoToAddress(p)
                CheckEqual(q.PseudoValue, p, "pseudo address round trip " & AgcWord.ToOctal(p))
            Next
        End Sub

        Private Sub TestIncrement()
            Dim a As AgcAddress = AgcCodec.PseudoToAddress(4096)
            Dim b As AgcAddress = AgcCodec.IncPc(a, 10)
            CheckEqual(b.SReg, 2058, "IncPc sub-address")
            Check(b.FB = 2, "IncPc keeps the bank")

            Dim c As AgcAddress = AgcCodec.IncPc(AgcCodec.PseudoToAddress(6144 - 1), 1)
            Check(c.Banked AndAlso c.FB = 4, "IncPc rolls into the next bank", c.ToString())

            Dim d As AgcAddress = AgcCodec.IncPc(AgcCodec.PseudoToAddress(1024), 5)
            Check(d.EB = 2 AndAlso d.SReg = 5125, "IncPc switched erasable", d.ToString())
        End Sub

        Private Sub TestDecEncoders()
            Dim ok As Boolean

            Dim v As Integer = AgcWord.EncodeSinglePrecision(0.5, "", "", True, ok)
            Check(ok, "DEC .5 accepted")
            CheckEqual(v, &H2000, "DEC .5 encodes as 040000")

            v = AgcWord.EncodeSinglePrecision(42.0, "", "", False, ok)
            CheckEqual(v, 42, "DEC 42 encodes as 42")

            Dim hi As Integer, lo As Integer
            AgcWord.EncodeDoublePrecision(0.25, "", "", True, hi, lo, ok)
            CheckEqual(hi, &H2000, "2DEC .25 high word")
            CheckEqual(lo, 0, "2DEC .25 low word")

            v = AgcWord.EncodeSinglePrecision(0.25, "B+1", "", True, ok)
            CheckEqual(v, &H2000, "DEC .25 B+1 is 040000")

            Check(Math.Abs(AgcWord.ScaleFactor("B-1") - 0.5) < 1.0E-12, "B-1 scale factor")
            Check(Math.Abs(AgcWord.ScaleFactor("E3") - 1000.0) < 1.0E-9, "E3 scale factor")
            Check(Math.Abs(AgcWord.ScaleFactor("") - 1.0) < 1.0E-12, "empty scale factor")

            v = AgcWord.EncodeVerbNoun("0607", ok)
            Check(ok, "VN accepted")
            CheckEqual(v, (7 Or (6 << 7)), "VN 06/07 packing")
        End Sub

        Private Sub TestLiteralParsing()
            Dim v As Integer
            Check(AgcWord.TryParseInteger("77777", v) AndAlso v = &H7FFF, "octal literal 77777")
            Check(AgcWord.TryParseInteger("77776", v) AndAlso v = &H7FFE, "octal literal 77776")
            Check(AgcWord.TryParseInteger("16383D", v) AndAlso v = 16383, "decimal literal 16383D")
            Check(AgcWord.TryParseInteger("99", v) AndAlso v = 99, "decimal literal 99")
            Check(AgcWord.TryParseInteger("+10", v) AndAlso v = 8, "octal literal +10")
            Check(AgcWord.TryParseInteger("-1", v) AndAlso v = -1, "signed literal -1")
            Check(Not AgcWord.TryParseInteger("ABC", v), "reject a symbol as a number")

            Check(AgcOctParser.TryParse("-1", v) AndAlso v = &H7FFE, "OCT -1 gives 077776")
            Check(AgcOctParser.TryParse("77776", v) AndAlso v = &H7FFE, "OCT 77776")
        End Sub

        Private Sub TestOpcodeTables()
            Dim o As AgcOpcode = Nothing

            Check(AgcOpcodeTable.TryGetBasic("TC", o) AndAlso o.Opcode = &H0, "TC opcode 00000")
            Check(AgcOpcodeTable.TryGetBasic("CCS", o) AndAlso o.Opcode = &H1000, "CCS opcode 010000")
            Check(AgcOpcodeTable.TryGetBasic("TCF", o) AndAlso o.Opcode = &H2000, "TCF opcode 020000")
            Check(AgcOpcodeTable.TryGetBasic("CA", o) AndAlso o.Opcode = &H9000, "CA opcode 0110000")
            Check(AgcOpcodeTable.TryGetBasic("XCH", o) AndAlso o.Opcode = &HF000, "XCH opcode 0170000")
            Check(AgcOpcodeTable.TryGetBasic("AD", o) AndAlso o.Opcode = &H10000, "AD opcode 0200000")
            Check(AgcOpcodeTable.TryGetBasic("BZF", o) AndAlso o.Opcode = &H40000, "BZF opcode 040000")
            Check(AgcOpcodeTable.TryGetBasic("BZMF", o) AndAlso o.Opcode = &H68000, "BZMF opcode 065000")
            Check(AgcOpcodeTable.TryGetBasic("DV", o) AndAlso o.Opcode = &H44000, "DV opcode 044000")
            Check(AgcOpcodeTable.TryGetBasic("MP", o) AndAlso o.Opcode = &H70000, "MP opcode 070000")
            Check(AgcOpcodeTable.TryGetBasic("SU", o) AndAlso o.Opcode = &H64000, "SU opcode 064000")

            Check(AgcOpcodeTable.TryGetInterpretive("VLOAD", o) AndAlso o.InterpreterCode = 1, "VLOAD code 001")
            Check(AgcOpcodeTable.TryGetInterpretive("DLOAD", o) AndAlso o.InterpreterCode = &H19, "DLOAD code 031")
            Check(AgcOpcodeTable.TryGetInterpretive("STODL", o) = False, "STODL is not an interpretive opcode")
        End Sub

        Private Sub TestInterpreterEncoding()
            ' A bare VLOAD (code 001) encodes as the complement of 002: 077775.
            Dim code As Integer = 1
            Dim word As Integer = (AgcWord.Mask15 And Not (code + 1)) And AgcWord.Mask15
            CheckEqual(word, &H7FFD, "VLOAD encodes as 077775")

            ' VLOAD followed by SETPD (code 0175) sets bit 7 of the stored code.
            Dim code2 As Integer = &H7D
            Dim stored As Integer = (&H7F And (code + 1)) Or ((code2 + 1) << 7)
            word = (AgcWord.Mask15 And Not stored) And AgcWord.Mask15
            CheckEqual(stored, &H3F02, "VLOAD + SETPD stored code")
            CheckEqual(word, &H40FD, "VLOAD + SETPD encodes as 040375")
        End Sub

        Private Sub TestTinyAssembly()
            Dim dir As String = Path.Combine(Path.GetTempPath(), "agc-selftest-" & Guid.NewGuid().ToString("N"))
            Directory.CreateDirectory(dir)
            Try
                Dim t As String = Chr(9) & Chr(9)
                Dim one As String = Chr(9)
                Dim src As New StringBuilder()
                src.AppendLine(t & "SETLOC" & one & "04000")
                src.AppendLine(t & "BANK")
                src.AppendLine("START" & t & "TC" & t & "START")
                src.AppendLine(t & "CA" & one & "Q")
                src.AppendLine(t & "OCT" & one & "12345")
                src.AppendLine(t & "DEC" & one & "42")
                src.AppendLine(t & "TCF" & t & "START")
                File.WriteAllText(Path.Combine(dir, "MAIN.agc"), src.ToString())

                Dim asm As New AgcAssembler()
                asm.SourceDirectory = dir
                asm.MainFile = "MAIN.agc"
                Dim ok As Boolean = asm.Assemble()

                Check(ok, "tiny assembly succeeds", asm.Diagnostics.FormatAll(10))
                CheckEqual(asm.Image.GetFixed(2, &H800), &H0, "TC START assembles as 00000")
                CheckEqual(asm.Image.GetFixed(2, &H801), &H110002, "CA Q assembles as 0110002")
                CheckEqual(asm.Image.GetFixed(2, &H802), &H12345, "OCT assembles")
                CheckEqual(asm.Image.GetFixed(2, &H803), 42, "DEC 42 assembles")
                CheckEqual(asm.Image.GetFixed(2, &H804), &H2800, "TCF START assembles as 028000")
            Finally
                Try
                    Directory.Delete(dir, True)
                Catch
                End Try
            End Try
        End Sub

    End Module

End Namespace
